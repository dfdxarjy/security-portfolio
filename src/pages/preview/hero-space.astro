---
import BaseLayout from "../../layouts/BaseLayout.astro";

const title = "Hero layout preview";
const description =
	"Temporary preview route comparing the current split homepage hero with a proposed collapsed single-column hero.";
---

<BaseLayout
	title={title}
	description={description}
	canonical="https://taktak.hu/preview/hero-space/"
	noindex={true}
	currentPath="/preview/hero-space/"
>
	<main id="main-content" tabindex="-1">
		<div
			class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 pb-16 lg:px-8"
		>
			<header class="border-b border-input py-10">
				<p
					class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-primary"
				>
					Temporary preview
				</p>
				<h1 class="mt-3 text-3xl tracking-[-0.04em] sm:text-4xl">
					Hero layout preview
				</h1>
				<p class="mt-2 max-w-[68ch] text-pretty text-muted-foreground">
					Two variants of the homepage hero for comparison. The current hero uses a
					12-column desktop grid with its content in 7 of those columns, leaving
					columns 8 to 12 empty. The proposed hero removes the desktop grid and flows
					as a single left-aligned column. This route is temporary and is deleted
					after the verdict.
				</p>
			</header>

			<section aria-labelledby="variant-current-title" class="py-10">
				<h2
					id="variant-current-title"
					class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground"
				>
					Current: split hero (<code>lg:grid-cols-12</code>, content
					<code>lg:col-span-7</code>)
				</h2>
				<div class="mt-2 rounded-xl border border-input bg-card px-6">
					<section
						class="grid grid-cols-1 gap-8 py-16 lg:grid-cols-12 lg:gap-6 lg:py-24"
						aria-labelledby="portfolio-title"
					>
						<div class="lg:col-span-7">
							<p
								class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-primary"
							>
								Security case studies
							</p>
							<h2
								id="portfolio-title"
								class="mt-4 max-w-[14ch] text-[clamp(3rem,1.75rem+6.5vw,7.5rem)] leading-[0.92] tracking-[-0.02em]"
							>
								TakTak
							</h2>
							<p
								class="mt-5 max-w-[68ch] text-pretty text-lg text-muted-foreground"
							>
								I focus on cybersecurity, with an emphasis on Active Directory, penetration testing, and incident investigation. I'm currently expanding my skills in SOC operations, DFIR, and detection engineering. I learn them through hands-on labs, HTB content, and practical security projects.
							</p>
							<div class="mt-7 flex flex-wrap gap-3">
								<a
									href="#explorer"
									class="inline-flex items-center rounded-md border border-primary bg-primary px-4 py-2 font-bold text-primary-foreground no-underline hover:brightness-110 focus-visible:brightness-110"
								>
									View case studies
								</a>
							</div>
						</div>
					</section>
				</div>
			</section>

			<section aria-labelledby="variant-collapsed-title" class="py-10">
				<h2
					id="variant-collapsed-title"
					class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground"
				>
					Proposed: collapsed single-column hero (no desktop grid)
				</h2>
				<div class="mt-2 rounded-xl border border-input bg-card px-6">
					<section
						class="grid grid-cols-1 gap-8 py-16 lg:py-24"
						aria-labelledby="portfolio-title-collapsed"
					>
						<div>
							<p
								class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-primary"
							>
								Security case studies
							</p>
							<h2
								id="portfolio-title-collapsed"
								class="mt-4 max-w-[14ch] text-[clamp(3rem,1.75rem+6.5vw,7.5rem)] leading-[0.92] tracking-[-0.02em]"
							>
								TakTak
							</h2>
							<p
								class="mt-5 max-w-[68ch] text-pretty text-lg text-muted-foreground"
							>
								I focus on cybersecurity, with an emphasis on Active Directory, penetration testing, and incident investigation. I'm currently expanding my skills in SOC operations, DFIR, and detection engineering. I learn them through hands-on labs, HTB content, and practical security projects.
							</p>
							<div class="mt-7 flex flex-wrap gap-3">
								<a
									href="#explorer"
									class="inline-flex items-center rounded-md border border-primary bg-primary px-4 py-2 font-bold text-primary-foreground no-underline hover:brightness-110 focus-visible:brightness-110"
								>
									View case studies
								</a>
							</div>
						</div>
					</section>
				</div>
			</section>
		</div>
	</main>
</BaseLayout>
