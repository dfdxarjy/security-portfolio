---
const directions = [
    {
        slug: "report",
        title: "Report",
        line: "Technical report — IBM Plex Serif headings, warm paper, hairline rules.",
    },
    {
        slug: "casefile",
        title: "Casefile",
        line: "Engineering notebook — Plex Sans/Mono, neutral, dense, dark-first.",
    },
    {
        slug: "editorial",
        title: "Editorial",
        line: "Magazine longform — Source Serif, generous rhythm, numbered margin.",
    },
];
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex" />
        <meta
            name="description"
            content="Visual-direction previews: report, casefile, editorial."
        />
          <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
          <link rel="canonical" href="https://taktak.hu/preview/" />
          <title>Preview — visual directions · taktak.hu</title>
        <style>
            :root {
                color-scheme: light;
            }
            body {
                max-width: 46rem;
                margin: 0 auto;
                padding: 4rem clamp(1.25rem, 5vw, 3rem) 5rem;
                background: #f3f0e8;
                color: #151b24;
                font-family: ui-sans-serif, system-ui, sans-serif;
                font-size: 1rem;
                line-height: 1.6;
            }
            h1 {
                margin: 0 0 0.5rem;
                font-size: 1.6rem;
                letter-spacing: -0.01em;
            }
            .intro {
                margin: 0 0 2.5rem;
                color: #626a73;
            }
            ul {
                list-style: none;
                margin: 0;
                padding: 0;
            }
            li {
                padding: 1.1rem 0;
                border-top: 1px solid #dad3c6;
            }
            li:last-child {
                border-bottom: 1px solid #dad3c6;
            }
            a {
                color: #245c73;
                text-decoration: none;
                font-weight: 600;
            }
            a:hover,
            a:focus-visible {
                text-decoration: underline;
            }
            .line {
                margin: 0.3rem 0 0;
                color: #626a73;
                font-size: 0.92rem;
            }
        </style>
    </head>
    <body>
        <h1>Visual directions</h1>
        <p class="intro">
            Three preview routes rendering the same sample content so only the
            styling differs. Pick one; these routes are removed afterwards.
        </p>
        <ul>
            {
                directions.map((direction) => (
                    <li>
                        <a href={`/preview/${direction.slug}/`}>
                            {direction.title}
                        </a>
                        <p class="line">{direction.line}</p>
                    </li>
                ))
            }
        </ul>
    </body>
</html>
