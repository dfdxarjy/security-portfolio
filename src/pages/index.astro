---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/home/HomeHero.tsx";
import FocusCards from "../components/home/FocusCards.tsx";
import Explorer from "../components/home/Explorer.tsx";
import { PERSON, PERSON_ID } from "../lib/schema.ts";

const title = "TakTak — Security Portfolio";
const description =
	"Security case studies across red and blue team work, incident investigation, and Windows and Active Directory environments.";

const allDocs = await getCollection("docs");
const studiesRaw = allDocs
	.filter(
		({ id, data }) =>
			id.startsWith("case-studies/") &&
			data.type === "case-study" &&
			data.status === "published-ready",
	)
	.sort((a, b) => a.data.title.localeCompare(b.data.title));

// Category derived from collection path so cards show factual, path-based labels.
const category = (study: (typeof studiesRaw)[number]) => {
	if (study.id.includes("/sherlocks/")) return "dfir";
	if (study.id.includes("/windows/")) return "windows";
	return "linux";
};
const label = (kind: string) =>
	kind === "dfir"
		? "DFIR / Sherlock"
		: `${kind[0].toUpperCase()}${kind.slice(1)} machine`;
const cleanDescription = (value: string) =>
	value
		.replace(/^A\s+sanitized\s+/i, "")
		.replace(/^sanitized\s+/i, "")
		.replace(/^./, (char) => char.toUpperCase());
// Normalized, lowercased haystack of the same user-visible fields the cards render.
const searchableText = (study: (typeof studiesRaw)[number]) =>
	[
		study.data.title,
		cleanDescription(study.data.description),
		category(study),
		label(category(study)),
		...(study.data.tags ?? []),
		study.data.objective,
		...(study.data.tools ?? []),
		study.data.skill,
		study.data.outcome,
	]
		.filter(Boolean)
		.join(" ")
		.replace(/\s+/g, " ")
		.trim()
		.toLowerCase();

// Serialisable payload handed to the hydrated explorer.
const studies = studiesRaw.map((study) => {
	const kind = category(study);
	return {
		id: study.id,
		href: `/${study.id}/`,
		title: study.data.title,
		description: cleanDescription(study.data.description),
		category: kind,
		label: label(kind),
		tools: study.data.tools ?? [],
		tags: study.data.tags ?? [],
		addedAt: study.data.addedAt ?? "",
		search: searchableText(study),
	};
});
// Hero rail: the newest three case studies, derived from the same serialised
// payload the explorer uses. Explicit immutable `addedAt` (portfolio-addition
// date) descending, then stable id ascending. Entries without `addedAt` are
// omitted. No Git commit time or file mtime is read, and `featured` is not
// consulted.
const railStudies = [...studies]
	.filter((study) => study.addedAt)
	.sort(
		(a, b) => b.addedAt.localeCompare(a.addedAt) || a.id.localeCompare(b.id),
	)
	.slice(0, 3);

// The only authorised `sameAs` URLs are the Markdown links in the profiles page;
// derive them from that raw body so no URL is hand-copied into this file.
// The docs loader strips a trailing `/index` from `entry.id`, so match the
// profiles page by id or, defensively, by its file path.
const profilesEntry = allDocs.find(
	({ id, filePath }) =>
		id === "profiles" ||
		(filePath ?? "").replace(/\\/g, "/").endsWith("profiles/index.md"),
);
const profilesBody = profilesEntry?.body ?? "";
const sameAs = [
	...profilesBody.matchAll(/\]\((https?:\/\/[^)\s]+)\)/g),
].map((match) => match[1]);

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			name: "taktak.hu",
			url: "https://taktak.hu/",
			description,
			author: { "@id": PERSON_ID },
			publisher: { "@id": PERSON_ID },
		},
		{ ...PERSON, sameAs },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	canonical="https://taktak.hu/"
	ogType="website"
	jsonLd={jsonLd}
	currentPath="/"
>
	<main id="main-content" tabindex="-1">
		<div class="mx-auto w-full max-w-[var(--portfolio-max-width)] px-4 pb-16 lg:px-8">
			<HomeHero studies={railStudies} />
			<FocusCards />
			<div data-reveal>
				<Explorer studies={studies} client:idle={{ timeout: 500 }} />
			</div>
		</div>
	</main>
</BaseLayout>
