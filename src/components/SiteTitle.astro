---
import BrandLockup from "./BrandLockup.astro";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <BrandLockup linked={false} wordmark={siteTitle} />
</a>

<style>
  @layer starlight.core {
    /* This override intentionally does not support Starlight's `logo` /
       `replacesTitle` options: the header brand is rendered by BrandLockup
       instead. Header clipping for a long title is already provided by
       Starlight's `.title-wrapper { overflow: clip }`, so no `overflow` rule is
       re-declared here. */
    .site-title {
      align-items: center;
      gap: var(--sl-nav-gap);
      font-size: var(--sl-text-h4);
      font-weight: 600;
      color: var(--sl-color-text-accent);
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }
  }
</style>
