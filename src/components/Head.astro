---
// Head override. Reproduces Starlight's default <head> output exactly, then
// appends valid JSON-LD only where it is accurate: a WebSite node on the site
// root and an Article + BreadcrumbList @graph on case-study pages.
//
// Starlight renders <Head /> with no props; the page data comes from
// `Astro.locals.starlightRoute` (see the default component, which maps `head`).
const { head, entry } = Astro.locals.starlightRoute;
const data = entry.data as {
	type?: string;
	title?: string;
	seoTitle?: string;
	description?: string;
	addedAt?: string;
	publishedAt?: string;
	updatedAt?: string;
};

// A case study may set a concise `seoTitle`; when present the browser/search
// <title> uses it and the rich `title` stays the visible <h1>. With no
// `seoTitle` the head array is rendered untouched.
const { title: pageTitle, seoTitle } = data;
const pageHead =
	seoTitle && pageTitle
		? head.map((headEntry) =>
				headEntry.tag === 'title' && headEntry.content
					? { ...headEntry, content: headEntry.content.replace(pageTitle, seoTitle) }
					: headEntry,
			)
		: head;

// The canonical link is generated by Starlight and already reflects the site URL
// and trailing-slash config, so reuse it rather than rebuilding it.
const canonical = head.find(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'canonical')?.attrs
	?.href as string | undefined;

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Human-readable labels for the known portfolio URL segments; any other segment
// falls back to title-casing its hyphenated words.
const SEGMENT_LABELS: Record<string, string> = {
	'case-studies': 'Case Studies',
	prolabs: 'Pro Labs',
	htb: 'Hack The Box',
	sherlocks: 'Sherlocks',
	dfir: 'DFIR',
	machines: 'Machines',
	windows: 'Windows',
	linux: 'Linux',
};
const labelFor = (segment: string) =>
	SEGMENT_LABELS[segment] ??
	segment
		.split('-')
		.filter(Boolean)
		.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
		.join(' ');

const breadcrumbItems = canonical
	? pathname
			.split('/')
			.filter(Boolean)
			.map((segment, index, segments) => ({
				'@type': 'ListItem',
				position: index + 1,
				name: labelFor(segment),
				item: new URL(`/${segments.slice(0, index + 1).join('/')}/`, Astro.site ?? canonical).href,
			}))
	: [];

const graph: Record<string, unknown>[] = [];

if (pathname === '/') {
	graph.push({ '@type': 'WebSite', name: 'taktak.hu', url: 'https://taktak.hu/' });
}

if (data.type === 'case-study' && canonical) {
	const article: Record<string, unknown> = { '@type': 'Article', headline: data.title };
	if (data.description) article.description = data.description;
	const datePublished = data.publishedAt ?? data.addedAt;
	if (datePublished) article.datePublished = datePublished;
	if (data.updatedAt) article.dateModified = data.updatedAt;
	article.url = canonical;
	graph.push(article);

	if (breadcrumbItems.length > 0) {
		graph.push({ '@type': 'BreadcrumbList', itemListElement: breadcrumbItems });
	}
}

const jsonLd = graph.length > 0 ? { '@context': 'https://schema.org', '@graph': graph } : undefined;
---

{pageHead.map(({ tag: Tag, attrs, content }) => <Tag {...attrs} set:html={content} />)}

{/* Referrer-Policy is the only security header GitHub Pages can honour, via
    <meta name="referrer">. Emitted directly since this override has no plain
    meta-tag pattern to reuse; it applies to every Starlight page. */}
<meta name="referrer" content="strict-origin-when-cross-origin" />

{
	jsonLd && (
		<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
	)
}
