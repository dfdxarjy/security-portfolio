---
// Sidebar override: case-study pages get a short case rail — a category back
// link plus the page's own `##` headings. Every other page renders Starlight's
// default sidebar verbatim, so docs chrome (and the mobile menu) is unchanged.
//
// Starlight renders Sidebar with no props; page data comes from
// `Astro.locals.starlightRoute` (see Head.astro for the same pattern).
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';

const { entry, headings } = Astro.locals.starlightRoute;
const isCaseStudy = (entry.data as { type?: string }).type === 'case-study';

// The rail lists the page's own H2 headings as jump links. Starlight already
// parsed these into the route's `headings`; do not re-parse the Markdown.
const sections = headings.filter((heading) => heading.depth === 2 && heading.slug);

// Derive the owning category index from the case URL, e.g.
// /case-studies/htb/machines/windows/escapetwo/ -> "Windows cases".
const dirParts = Astro.url.pathname.replace(/\/+$/, '').split('/').filter(Boolean).slice(0, -1);
const dirKey = dirParts.join('/');
const categoryLabel = dirKey.endsWith('machines/windows')
	? 'Windows cases'
	: dirKey.endsWith('machines/linux')
		? 'Linux cases'
		: dirKey.endsWith('sherlocks/dfir')
			? 'DFIR cases'
			: `${(dirParts.at(-1) ?? 'case').replace(/(^|[- ])\w/g, (c) => c.toUpperCase())} cases`;
const categoryHref = `/${dirKey}/`;
---

{
	isCaseStudy ? (
		<nav class="case-rail" aria-label="Case navigation">
			<a class="case-rail__back" href={categoryHref}>
				<span aria-hidden="true">←</span> {categoryLabel}
			</a>
			{sections.length > 0 && (
				<div class="case-rail__group">
					<h2 class="case-rail__title">Contents</h2>
					<ul class="case-rail__list">
						{sections.map((heading) => (
							<li>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</nav>
	) : (
		<DefaultSidebar />
	)
}

<style>
	.case-rail {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-align: left;
	}
	.case-rail__back {
		color: var(--portfolio-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	.case-rail__back:hover,
	.case-rail__back:focus-visible {
		text-decoration: underline;
	}
	.case-rail__group {
		border-top: 1px solid var(--portfolio-line);
		padding-top: 1rem;
	}
	.case-rail__title {
		margin: 0 0 0.5rem;
		color: var(--portfolio-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.case-rail__list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.82rem;
	}
	.case-rail__list a {
		color: var(--portfolio-muted);
		text-decoration: none;
	}
	.case-rail__list a:hover,
	.case-rail__list a:focus-visible {
		color: var(--portfolio-accent);
		text-decoration: underline;
	}
</style>
