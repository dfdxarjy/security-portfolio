---
// Sidebar override: case-study pages get a short case rail — a category back
// link plus the page's own `##` headings. Every other page renders Starlight's
// default sidebar verbatim, so docs chrome (and the mobile menu) is unchanged.
//
// Starlight renders Sidebar with no props; page data comes from
// `Astro.locals.starlightRoute` (see Head.astro for the same pattern).
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';

const { entry, headings } = Astro.locals.starlightRoute;
const isCaseStudy = (entry.data as { type?: string }).type === 'case-study';

// The rail lists the page's own H2 headings as jump links. Starlight already
// parsed these into the route's `headings`; do not re-parse the Markdown.
const sections = headings.filter((heading) => heading.depth === 2 && heading.slug);

// Derive the owning category index from the case URL, e.g.
// /case-studies/htb/machines/windows/escapetwo/ -> "Windows cases".
const dirParts = Astro.url.pathname.replace(/\/+$/, '').split('/').filter(Boolean).slice(0, -1);
const dirKey = dirParts.join('/');
const categoryLabel = dirKey.endsWith('machines/windows')
	? 'Windows cases'
	: dirKey.endsWith('machines/linux')
		? 'Linux cases'
		: dirKey.endsWith('sherlocks/dfir')
			? 'DFIR cases'
			: `${(dirParts.at(-1) ?? 'case').replace(/(^|[- ])\w/g, (c) => c.toUpperCase())} cases`;
const categoryHref = `/${dirKey}/`;
---

{
	isCaseStudy ? (
		<nav class="case-rail" aria-label="Case navigation">
			<a class="case-rail__back" href={categoryHref}>
				<span aria-hidden="true">←</span> {categoryLabel}
			</a>
			{sections.length > 0 && (
				<div class="case-rail__group">
					<h2 class="case-rail__title">Contents</h2>
					<ul class="case-rail__list">
						{sections.map((heading) => (
							<li>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ul>
				</div>
			)}
		</nav>
	) : (
		<DefaultSidebar />
	)
}

<script>
	// Case-rail scrollspy. The Contents list is built from the page's own H2s;
	// this marks the entry for the section currently being read. It is additive
	// only: with JavaScript off the rail stays a plain, working list of links.
	const railLinks = document.querySelectorAll('.case-rail__list a[href^="#"]');
	// Idempotence: a second execution (dev hot reload, future view transitions)
	// must not stack heading observers and resize listeners. One marker on
	// documentElement makes the whole initialisation a no-op after the first.
	if (railLinks.length > 0 && !document.documentElement.hasAttribute('data-case-rail-init')) {
		document.documentElement.setAttribute('data-case-rail-init', '');
		const targets = [];
		for (const link of railLinks) {
			// The href is already an encoded slug; decode defensively so a
			// malformed percent sequence cannot throw and abort the spy.
			let id = link.hash.slice(1);
			try {
				id = decodeURIComponent(id);
			} catch {
				// Keep the raw fragment.
			}
			const heading = document.getElementById(id);
			if (heading) targets.push({ link, heading });
		}

		if (targets.length > 0) {
			// Latest viewport-relative top seen for each heading. The observer
			// only fires as a heading crosses the header line, so this stays in
			// sync without a scroll listener reading layout every frame.
			const tops = new Map();
			let current = null;
			let atEnd = false;

			const setCurrent = (link) => {
				if (link === current) return;
				if (current) current.removeAttribute('aria-current');
				current = link;
				if (link) link.setAttribute('aria-current', 'location');
			};

			// "Current" = the last heading whose top has passed beneath the
			// sticky header (its scroll-padding-top line); below that, the first.
			// At the document end the last entry wins, because a short final
			// section cannot always be scrolled up to that line.
			const recompute = () => {
				const offset =
					parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
				let active = targets[0].link;
				if (atEnd) {
					active = targets[targets.length - 1].link;
				} else {
					for (const { link, heading } of targets) {
						const top = tops.get(heading);
						if (top !== undefined && top <= offset + 1) active = link;
					}
				}
				setCurrent(active);
			};

			let observer = null;
			const observe = () => {
				if (observer) observer.disconnect();
				const offset =
					parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
				// A thin band `band` px either side of the header line, so a
				// heading that snaps to exactly the line still registers.
				const band = 2;
				const bandBottom = Math.max(0, window.innerHeight - offset - band);
				observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) tops.set(entry.target, entry.boundingClientRect.top);
						recompute();
					},
					{ rootMargin: `${-Math.max(0, offset - band)}px 0px ${-bandBottom}px 0px`, threshold: 0 }
				);
				for (const { heading } of targets) observer.observe(heading);
			};

			// Inert sentinel at the document end. A real 1px box: a zero-area
			// target is not guaranteed to report `isIntersecting`, which would
			// leave the final section unmarked. Absolutely positioned with no
			// offsets, so it stays out of flow at its static spot at the document
			// end, and the negative top margin pulls its box back so it does not
			// extend the scrollable area or add layout; it is never focusable.
			const existing = document.querySelector('div[data-case-rail-sentinel]');
			let sentinel;
			if (existing instanceof HTMLElement) {
				sentinel = existing;
			} else {
				sentinel = document.createElement('div');
				sentinel.dataset.caseRailSentinel = '';
				sentinel.setAttribute('aria-hidden', 'true');
				sentinel.style.cssText =
					'position: absolute; height: 1px; width: 1px; margin-top: -1px; pointer-events: none;';
				document.body.append(sentinel);
			}
			// Guard the observer too, so a re-executed script cannot stack them.
			if (!sentinel.dataset.caseRailObserved) {
				sentinel.dataset.caseRailObserved = '';
				new IntersectionObserver(
					(entries) => {
						const reachedEnd =
							entries.some((entry) => entry.isIntersecting) &&
							document.documentElement.scrollHeight > window.innerHeight;
						if (reachedEnd === atEnd) return;
						atEnd = reachedEnd;
						recompute();
					},
					// A modest 8px window below the viewport: enough that the very
					// end registers and small jitter near the bottom cannot drop
					// the mark, while staying far too small to fire while the
					// reader is still in the second-to-last section.
					{ rootMargin: '0px 0px 8px 0px', threshold: 0 }
				).observe(sentinel);
			}

			observe();
			let resizeFrame = 0;
			window.addEventListener('resize', () => {
				cancelAnimationFrame(resizeFrame);
				resizeFrame = requestAnimationFrame(observe);
			});
		}
	}
</script>

<style>
	.case-rail {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		text-align: left;
	}
	.case-rail__back {
		color: var(--portfolio-accent);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		text-decoration: none;
	}
	.case-rail__back:hover,
	.case-rail__back:focus-visible {
		text-decoration: underline;
	}
	.case-rail__group {
		border-top: 1px solid var(--portfolio-line);
		padding-top: 1rem;
	}
	.case-rail__title {
		margin: 0 0 0.5rem;
		color: var(--portfolio-muted);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.case-rail__list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 0.82rem;
	}
	.case-rail__list a {
		color: var(--portfolio-muted);
		text-decoration: none;
	}
	.case-rail__list a:hover,
	.case-rail__list a:focus-visible {
		color: var(--portfolio-accent);
		text-decoration: underline;
	}
	.case-rail__list a[aria-current='location'] {
		color: var(--portfolio-accent);
		font-weight: 600;
	}
</style>
