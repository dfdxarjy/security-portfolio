---
// TableOfContents override: case-study pages swap the on-this-page column for
// the case info rail (metadata + related cases). Every other page renders
// Starlight's default table of contents unchanged.
import DefaultTableOfContents from '@astrojs/starlight/components/TableOfContents.astro';
import CaseInfoPanel from './CaseInfoPanel.astro';

const { entry } = Astro.locals.starlightRoute;
const isCaseStudy = (entry.data as { type?: string }).type === 'case-study';
---

{isCaseStudy ? <CaseInfoPanel /> : <DefaultTableOfContents />}
