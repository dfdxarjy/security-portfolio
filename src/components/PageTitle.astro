---
// PageTitle override. Reproduces Starlight's default <h1> exactly. The case
// metadata (Tools / Skill / Tags) lives once, in the case info rail
// (CaseInfoPanel), which TableOfContents and MobileTableOfContents render at
// every breakpoint — so it is not repeated here.
//
// Starlight 0.42 renders <PageTitle /> with no props; the page data comes from
// `Astro.locals.starlightRoute.entry.data` (see Page.astro:109 and the default
// component). Title id mirrors Starlight's PAGE_TITLE_ID constant (`_top`).
const { entry } = Astro.locals.starlightRoute;
const data = entry.data as { title: string };
---

<h1 id="_top">{data.title}</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	/* Mirrors the homepage's `portfolio-feature-evidence` visual language.
	   Kept so the global stylesheet bundle hash stays stable; the markup these
	   once styled now lives (once) in the case info rail, CaseInfoPanel. */
	.portfolio-doc-evidence {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.35rem 1rem;
		margin: 1rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--portfolio-line);
	}
	.portfolio-doc-evidence dt {
		color: var(--portfolio-accent);
		font-size: 0.7rem;
		font-weight: 750;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.portfolio-doc-evidence dd {
		margin: 0;
		color: var(--portfolio-muted);
		font-size: 0.85rem;
	}
	.portfolio-doc-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.portfolio-doc-tag {
		border-radius: var(--portfolio-radius-sm);
		background: var(--portfolio-accent-soft);
		padding: 0.2rem 0.45rem;
		color: var(--portfolio-accent);
		font-size: 0.72rem;
	}
</style>
