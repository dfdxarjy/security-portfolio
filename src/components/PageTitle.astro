---
// PageTitle override. Reproduces Starlight's default <h1> exactly. The case
// metadata (Tools / Skill / Tags) lives once, in the case info rail
// (CaseInfoPanel), which TableOfContents and MobileTableOfContents render at
// every breakpoint — so it is not repeated here.
//
// Starlight 0.42 renders <PageTitle /> with no props; the page data comes from
// `Astro.locals.starlightRoute.entry.data` (see Page.astro:109 and the default
// component). Title id mirrors Starlight's PAGE_TITLE_ID constant (`_top`).
const { entry } = Astro.locals.starlightRoute;
const data = entry.data as { title: string };
---

<h1 id="_top">{data.title}</h1>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

</style>
