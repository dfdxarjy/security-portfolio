---
// Doc-page footer override. Keeps Starlight's default page meta/pagination and
// appends the shared branded footer so docs and homepage share one identity.
// Case pages drop the "edit this page" link (docs chrome the case-file shell
// deliberately omits); every other page keeps it.
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
// Local override: renders Starlight's pagination everywhere except case pages.
import Pagination from './Pagination.astro';

const { entry } = Astro.locals.starlightRoute;
const isCaseStudy = (entry.data as { type?: string }).type === 'case-study';
---

<div class="portfolio-doc-meta">
  {!isCaseStudy && <EditLink />}
  <LastUpdated />
</div>
<Pagination />

<footer class="portfolio-footer">
  <p>&copy; 2026 taktak.hu</p>
  <nav class="portfolio-footer-links" aria-label="Footer">
    <a href="/">Home</a>
    <a href="/case-studies/">Case Studies</a>
    <a href="/prolabs/">Pro Labs</a>
    <a href="/profiles/">Profiles</a>
    <a href="https://github.com/dfdxarjy/security-portfolio">Source</a>
    <a href="https://github.com/dfdxarjy/security-portfolio/issues/new">Contact</a>
  </nav>
</footer>
