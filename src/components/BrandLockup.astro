---
import BrandMark from "./BrandMark.astro";

interface Props {
  href?: string;
  class?: string;
  showMark?: boolean;
  showWordmark?: boolean;
  linked?: boolean;
  wordmark?: string;
}

const {
  href = "/",
  class: className = "",
  showMark = false,
  showWordmark = true,
  linked = true,
  wordmark = "taktak.hu",
} = Astro.props;

const Tag = linked ? "a" : "span";
---

<Tag class:list={["brand-lockup", className]} href={linked ? href : undefined} aria-label={showWordmark ? undefined : wordmark}>
  {/* The mark is an inline-flex whose first flex item is real text, so its own
      baseline is that text's baseline and the parent's `align-items: baseline`
      aligns it with no nudge. */}
  {showMark && <BrandMark class="brand-lockup__mark" decorative={showWordmark} />}
  {showWordmark && <span class="brand-wordmark" translate="no">{wordmark}</span>}
</Tag>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: baseline;
    gap: .27em;
    color: var(--portfolio-ink, #1a1a17);
    text-decoration: none;
    font-weight: 600;
    font-synthesis: none;
  }

  .brand-wordmark {
    font-family: var(--font-display, "Source Serif 4", Georgia, serif);
    font-size: 1em;
    font-style: normal;
    font-weight: 600;
    font-synthesis: none;
    letter-spacing: -.01em;
    line-height: 1;
    white-space: nowrap;
  }
</style>
